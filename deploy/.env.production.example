# Production environment template (store live secrets in /etc/sdrt/sdrt.env with chmod 600 sdrt:sdrt)
SDRT_DATABASE_URL=mysql+pymysql://sdrt_app:REPLACE_WITH_LEAST_PRIVILEGE_PASSWORD@127.0.0.1:3306/sdrt?charset=utf8mb4
SDRT_CSRF_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
SDRT_ENVIRONMENT=production
SDRT_SECURE_COOKIES=true
SDRT_ALLOWED_ORIGINS=["https://sdrt.example.edu"]
SDRT_PRIVATE_DIR=/var/lib/sdrt/private_uploads
# Keep seed password unset in production once controlled initial accounts are provisioned
SDRT_SEED_PASSWORD=
